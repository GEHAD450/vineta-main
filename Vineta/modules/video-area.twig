{% if not settings.hide_all_section %}
<section section-id="{{ sectionId }}" data-lg-scroll-offset="130" data-md-scroll-offset="130" data-sm-scroll-offset="94" 
class="video-hero-section {% if settings.upload_video %}has-video-bg{% endif %} {% if settings.video_layout == 'container' %}container-layout{% else %}fullscreen-layout{% endif %} pb-{% if settings.padding_bottom and settings.padding_bottom != 'default' %}{{ settings.padding_bottom }}{% else %}100{% endif %} pt-{% if settings.padding_top and settings.padding_top != 'default' %}{{ settings.padding_top }}{% else %}100{% endif %}"
{% if settings.bg_color %} style="background-color:{{ settings.bg_color }};" {% endif %}>
    <div class="{% if settings.video_layout == 'container' %}container{% endif %}">
      <div class="video-layout">
      
      {% if settings.upload_video %}
      <div class="video-background">
        <video id="bg-video-{{ sectionId }}" autoplay muted loop playsinline class="bg-video" preload="auto">
          <source src="{{ settings.upload_video }}" type="video/mp4">
          <source src="{{ settings.upload_video }}" type="video/webm">
          <source src="{{ settings.upload_video }}" type="video/ogg">
          {% if settings.bg_img %}
          <img src="{{ settings.bg_img }}" alt="Video fallback" style="width: 100%; height: 100%; object-fit: cover;">
          {% endif %}
        </video>
        <div class="video-overlay" style="{% if settings.video_overlay_color %}background-color:{{ settings.video_overlay_color }};{% else %}background-color: rgba(0,0,0,0.4);{% endif %}{% if settings.video_overlay_opacity %}opacity:{{ settings.video_overlay_opacity }};{% else %}opacity: 0.4;{% endif %}"></div>
      </div>
      {% endif %}
      
      {% if settings.bg_img %}
      <div class="bg-position {% if settings.upload_video %}video-fallback-bg{% endif %}" style="background-image: url({{ settings.bg_img }});background-size: cover; background-position: center; {% if settings.bg_attachment %} background-attachment: fixed;{% endif %}{% if settings.upload_video %} display: none;{% endif %}" id="bg-position-video-{{ sectionId }}"></div>
       {% endif %}
       
       {% if settings.overlay and not settings.upload_video %}
          <div class="overlay" style="{% if settings.overlay_color %} background-color:{{ settings.overlay_color }};{% endif %}{% if settings.overlay_opacity %} opacity:{{ settings.overlay_opacity }} {% endif %}"></div>
        {% endif %}
        
      {% if settings.show_video_controls and settings.upload_video %}
        <div class="video-controls">
          <button class="video-control-btn play-pause-btn" data-video="bg-video-{{ sectionId }}">
            <i class="fas fa-pause"></i>
          </button>
          <button class="video-control-btn mute-btn" data-video="bg-video-{{ sectionId }}">
            <i class="fas fa-volume-mute"></i>
          </button>
        </div>
      {% endif %}
      
      {% if settings.show_popup_button %}
        {% if settings.upload_video %} 
          <a href="{{ settings.upload_video }}" class="play-btn popup-video">
            <i>
              <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="var(--primary-color)" height="80px" width="80px" version="1.1" id="Capa_1" viewBox="0 0 60 60" xml:space="preserve" style="margin-left: -3px;">
                <g>
                  <path d="M45.563,29.174l-22-15c-0.307-0.208-0.703-0.231-1.031-0.058C22.205,14.289,22,14.629,22,15v30   c0,0.371,0.205,0.711,0.533,0.884C22.679,45.962,22.84,46,23,46c0.197,0,0.394-0.059,0.563-0.174l22-15   C45.836,30.64,46,30.331,46,30S45.836,29.36,45.563,29.174z M24,43.107V16.893L43.225,30L24,43.107z"></path>
                </g>
              </svg>
            </i>
          </a>
        {% elseif settings.video_link %}
          <a href="{{ settings.video_link }}" class="play-btn popup-video">
            <i>
              <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="var(--primary-color)" height="80px" width="80px" version="1.1" id="Capa_1" viewBox="0 0 60 60" xml:space="preserve" style="margin-left: -3px;">
                <g>
                  <path d="M45.563,29.174l-22-15c-0.307-0.208-0.703-0.231-1.031-0.058C22.205,14.289,22,14.629,22,15v30   c0,0.371,0.205,0.711,0.533,0.884C22.679,45.962,22.84,46,23,46c0.197,0,0.394-0.059,0.563-0.174l22-15   C45.836,30.64,46,30.331,46,30S45.836,29.36,45.563,29.174z M24,43.107V16.893L43.225,30L24,43.107z"></path>
                </g>
              </svg>
            </i>
          </a>
        {% endif %}
      {% endif %}
      
      <div class="video-content-bottom-right">
        {% if settings.sub_title or settings.title %}
          <div class="video-text-content">
            {% if settings.title %}
              <h2 class="sec-title" style="{% if settings.text_color %}color:{{ settings.text_color }};{% endif %}">{{ settings.title }}</h2>
            {% endif %}
            {% if settings.subtitle %}
              <span class="sec-subtitle" style="{% if settings.text_color %}color:{{ settings.text_color }};{% endif %}">{{ settings.subtitle }}</span>
            {% endif %}
          </div>
        {% endif %}
        {% if settings.button_text and settings.button_link %}
          <a href="{{ settings.button_link }}" class="video-btn hbtn1 {% if settings.button_style == 'outline' %}style-outline{% elseif settings.button_style == 'glass' %}style-glass{% endif %}" {% if settings.new_tab %} target="_blank" {% endif %}>{{ settings.button_text }}</a>
        {% endif %}
      </div>
    </div>
    </div>
</section>



<script>
document.addEventListener('DOMContentLoaded', function() {
    const videoSections = document.querySelectorAll('.video-hero-section');
    
    videoSections.forEach(section => {
        const video = section.querySelector('.bg-video');
        const fallbackBg = section.querySelector('.video-fallback-bg');
        
        if (video) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        video.play().catch(e => {
                            console.log('Video autoplay failed:', e);
                            if (fallbackBg) {
                                fallbackBg.style.display = 'block';
                            }
                        });
                    } else {
                        video.pause();
                    }
                });
            }, { threshold: 0.1 });
            
            observer.observe(section);
            
            video.addEventListener('loadeddata', function() {
                this.classList.add('loaded');
                if (fallbackBg) {
                    fallbackBg.style.display = 'none';
                }
            });
            
            video.addEventListener('error', function() {
                console.log('Video failed to load');
                if (fallbackBg) {
                    fallbackBg.style.display = 'block';
                }
            });
        }
        
        const playPauseBtn = section.querySelector('.play-pause-btn');
        const muteBtn = section.querySelector('.mute-btn');
        
        if (playPauseBtn && video) {
            playPauseBtn.addEventListener('click', function() {
                const icon = this.querySelector('i');
                if (video.paused) {
                    video.play();
                    icon.className = 'fas fa-pause';
                } else {
                    video.pause();
                    icon.className = 'fas fa-play';
                }
            });
        }
        
        if (muteBtn && video) {
            muteBtn.addEventListener('click', function() {
                const icon = this.querySelector('i');
                if (video.muted) {
                    video.muted = false;
                    icon.className = 'fas fa-volume-up';
                } else {
                    video.muted = true;
                    icon.className = 'fas fa-volume-mute';
                }
            });
        }
    });
    
    const videoButtons = document.querySelectorAll('.video-btn');
    videoButtons.forEach(btn => {
        btn.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-3px) scale(1.02)';
        });
        
        btn.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0) scale(1)';
        });
    });
});
</script>

